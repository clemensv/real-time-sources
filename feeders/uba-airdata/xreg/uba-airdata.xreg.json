  "schemagroups": {
    "de.uba.airdata.jstruct": {
      "schemas": {
        "de.uba.airdata.Station": {
          "name": "Station",
          "format": "JsonStructure/draft-02",
          "defaultversionid": "1",
          "versions": {
            "1": {
              "format": "JsonStructure/draft-02",
              "schema": {
                "$schema": "https://json-structure.org/meta/core/v0/#",
                "$id": "https://github.com/clemensv/real-time-sources/schemas/de/uba/airdata/Station",
                "name": "Station",
                "$root": "#/definitions/de/uba/airdata/Station",
                "definitions": {
                  "de": {
                    "uba": {
                      "airdata": {
                        "Station": {
                          "name": "Station",
                          "type": "object",
                          "description": "Reference data for a UBA air quality monitoring station, including geographic position, station environment, and the denormalized monitoring network metadata published by the UBA air_data/v3 station catalog.",
                          "properties": {
                            "station_id": {
                              "type": "int32",
                              "description": "Stable numeric UBA station identifier from the 'station id' column. This is the station key used for CloudEvents subject and Kafka key."
                            },
                            "station_code": {
                              "type": "string",
                              "description": "Official station code from the 'station code' column, typically the European Environment Agency style identifier such as 'DEBE021' or 'DEBB003'."
                            },
                            "station_name": {
                              "type": "string",
                              "description": "Human-readable station name from the 'station name' column as published by UBA."
                            },
                            "station_city": {
                              "type": "string",
                              "description": "City or locality from the 'station city' column where the monitoring station is located."
                            },
                            "station_synonym": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "description": "Legacy or alternate station short code from the 'station synonym' column. UBA may publish an empty value when no synonym exists."
                            },
                            "active_from": {
                              "type": "string",
                              "description": "Station activation date from the 'station active from' column in ISO date form 'YYYY-MM-DD'."
                            },
                            "active_to": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "description": "Station deactivation date from the 'station active to' column in ISO date form 'YYYY-MM-DD'. Null means the station is still active."
                            },
                            "longitude": {
                              "type": "double",
                              "description": "Station longitude from the 'station longitude' column in WGS84 decimal degrees."
                            },
                            "latitude": {
