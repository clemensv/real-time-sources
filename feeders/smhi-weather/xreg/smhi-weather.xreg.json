        "producer"
      ],
      "protocol": "KAFKA",
      "envelope": "CloudEvents/1.0",
      "envelopeoptions": {
        "mode": "structured",
        "format": "application/cloudevents+json"
      },
      "protocoloptions": {
        "deployed": false,
        "options": {
          "topic": "smhi-weather",
          "key": "{station_id}"
        }
      },
      "messagegroups": [
        "#/messagegroups/SE.Gov.SMHI.Weather",
        "#/messagegroups/SE.Gov.SMHI.Weather.avro",
        "#/messagegroups/SE.Gov.SMHI.Weather.avro.binary"
      ],
      "description": "Kafka producer endpoint for SMHI Weather CloudEvents on the `smhi-weather` topic keyed by `{station_id}`."
    },
