  "schemagroups": {
    "SE.Gov.SMHI.Weather.jstruct": {
      "schemas": {
        "SE.Gov.SMHI.Weather.Station": {
          "name": "Station",
          "format": "JsonStructure/draft-02",
          "defaultversionid": "1",
          "versions": {
            "1": {
              "format": "JsonStructure/draft-02",
              "schema": {
                "$schema": "https://json-structure.org/meta/extended/v0/#",
                "$id": "https://opendata-download-metobs.smhi.se/schemas/SE/Gov/SMHI/Weather/Station",
                "type": "object",
                "name": "Station",
                "description": "A reference record published by the Swedish Meteorological and Hydrological Institute (SMHI). It lets consumers label, group, and route the live measurement or forecast events.",
                "required": [
                  "station_id",
                  "name",
                  "latitude",
                  "longitude"
                ],
                "properties": {
                  "station_id": {
                    "type": "string",
                    "description": "SMHI numeric station identifier, unique within the SMHI observation network."
                  },
                  "name": {
                    "type": "string",
                    "description": "Human-readable station name as assigned by SMHI, e.g. 'Abisko Aut' or 'Stockholm-Arlanda'."
                  },
                  "owner": {
                    "type": "string",
                    "description": "Organization or entity that owns and operates the station, e.g. 'SMHI' or 'Polarforskningssekretariatet'."
                  },
                  "owner_category": {
                    "type": "string",
                    "description": "Category of station ownership, e.g. 'CLIMATE' for long-running climate stations or 'AVIATION' for airport stations."
                  },
                  "measuring_stations": {
                    "type": "string",
                    "description": "Station classification within SMHI's measuring station network, e.g. 'CORE' for primary network stations."
                  },
                  "height": {
                    "type": "double",
                    "description": "Sensor height above ground in meters.",
                    "unit": "m",
                    "symbol": "m"
                  },
                  "latitude": {
                    "type": "double",
                    "description": "Geographic latitude of the station in decimal degrees.",
                    "unit": "degree",
                    "symbol": "°"
                  },
                  "longitude": {
                    "type": "double",
                    "description": "Geographic longitude of the station in decimal degrees.",
                    "unit": "degree",
                    "symbol": "°"
                  },
                  "lan": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Normalized routing field 'lan' added for MQTT/AMQP subscriber filtering."
                  }
                },
                "$uses": [
                  "JSONStructureUnits"
                ]
              }
            }
          }
        },
        "SE.Gov.SMHI.Weather.WeatherObservation": {
          "name": "WeatherObservation",
          "format": "JsonStructure/draft-02",
          "defaultversionid": "1",
          "versions": {
            "1": {
              "format": "JsonStructure/draft-02",
              "schema": {
                "$schema": "https://json-structure.org/meta/extended/v0/#",
                "$id": "https://opendata-download-metobs.smhi.se/schemas/SE/Gov/SMHI/Weather/WeatherObservation",
                "type": "object",
                "name": "WeatherObservation",
                "description": "A current environmental measurement from the Swedish Meteorological and Hydrological Institute (SMHI). It carries weather observations when the upstream feed reports a new or refreshed value.",
                "required": [
                  "station_id",
                  "station_name",
                  "observation_time"
                ],
                "properties": {
                  "station_id": {
                    "type": "string",
                    "description": "SMHI station identifier for the reporting station."
                  },
                  "station_name": {
                    "type": "string",
                    "description": "Human-readable name of the reporting station."
                  },
                  "observation_time": {
                    "type": "datetime",
                    "description": "Timestamp of the observation in UTC, derived from the SMHI epoch millisecond value."
                  },
                  "air_temperature": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Instantaneous air temperature, reported hourly (SMHI parameter 1).",
                    "unit": "Cel",
                    "symbol": "°C"
                  },
                  "wind_gust": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Maximum wind gust speed, reported hourly (SMHI parameter 21).",
                    "unit": "m/s",
                    "symbol": "m/s"
                  },
                  "dew_point": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Dew point temperature, reported hourly (SMHI parameter 39).",
                    "unit": "Cel",
                    "symbol": "°C"
                  },
                  "air_pressure": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Atmospheric pressure reduced to mean sea level, reported hourly (SMHI parameter 9).",
                    "unit": "hPa",
                    "symbol": "hPa"
                  },
                  "relative_humidity": {
                    "type": [
                      "int32",
                      "null"
                    ],
                    "description": "Relative humidity as a percentage, reported hourly (SMHI parameter 6).",
                    "unit": "percent",
                    "symbol": "%"
                  },
                  "precipitation_last_hour": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Total precipitation in the last hour, reported hourly (SMHI parameter 7).",
                    "unit": "mm",
                    "symbol": "mm"
                  },
                  "wind_direction": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Wind direction in degrees from which the wind is blowing, measured at 10 m height, reported hourly (SMHI parameter 3).",
                    "unit": "degree",
                    "symbol": "°"
                  },
                  "wind_speed": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Mean wind speed over 10 minutes measured at 10 m height, reported hourly (SMHI parameter 4).",
                    "unit": "m/s",
                    "symbol": "m/s"
                  },
                  "max_wind_speed": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Maximum of 10-minute mean wind speed during the hour, measured at 10 m height (SMHI parameter 25).",
                    "unit": "m/s",
                    "symbol": "m/s"
                  },
                  "visibility": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Horizontal visibility, reported hourly (SMHI parameter 12).",
                    "unit": "km",
                    "symbol": "km"
                  },
                  "total_cloud_cover": {
                    "type": [
                      "int32",
                      "null"
                    ],
                    "description": "Total cloud cover in oktas (eighths of sky covered), reported hourly (SMHI parameter 16).",
                    "unit": "okta",
                    "symbol": "okta"
                  },
                  "present_weather": {
                    "type": [
                      "int32",
                      "null"
                    ],
                    "description": "WMO present weather code (ww table 4677) describing current weather phenomena at the time of observation (SMHI parameter 13). Values range from 0 (clear) to 99 (thunderstorm with hail)."
                  },
                  "sunshine_duration": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Duration of sunshine during the last hour in seconds (SMHI parameter 10).",
                    "unit": "s",
                    "symbol": "s"
                  },
                  "global_irradiance": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Global solar irradiance (direct + diffuse), average over the hour, measured by pyranometer (SMHI parameter 11).",
                    "unit": "W/m2",
                    "symbol": "W/m²"
                  },
                  "precipitation_intensity": {
                    "type": [
                      "double",
                      "null"
                    ],
                    "description": "Instantaneous precipitation intensity measured by optical or weighing gauge (SMHI parameter 38).",
                    "unit": "mm/h",
                    "symbol": "mm/h"
                  },
                  "quality": {
                    "type": "string",
                    "description": "Quality flag for the observation as assigned by SMHI: 'G' for approved, 'Y' for suspect."
                  },
                  "lan": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Normalized routing field 'lan' added for MQTT/AMQP subscriber filtering."
                  }
                },
                "$uses": [
                  "JSONStructureUnits"
                ]
              }
            }
          }
        }
      }
    },
