      "envelope": "CloudEvents/1.0",
      "envelopeoptions": {
        "mode": "structured",
        "format": "application/cloudevents+json"
      },
      "protocoloptions": {
        "deployed": false,
        "options": {
          "topic": "epa-uv",
          "key": "{location_id}"
        }
      },
      "messagegroups": [
        "#/messagegroups/US.EPA.UVIndex",
        "#/messagegroups/US.EPA.UVIndex.avro",
        "#/messagegroups/US.EPA.UVIndex.avro.binary"
      ]
    },
