                  "city_slug",
                  "state",
                  "forecast_date",
                  "uv_index",
                  "uv_alert"
                ],
                "name": "DailyForecast",
                "description": "Daily UV Index forecast and alert flag for a configured city and state from the EPA Envirofacts UV daily service.",
                "properties": {
                  "location_id": {
                    "type": "string",
                    "description": "Stable slug derived from the configured city and state."
                  },
                  "city": {
                    "type": "string",
                    "description": "City for which the daily UV forecast was requested."
                  },
                  "state": {
                    "type": "string",
                    "description": "Lowercase two-letter US state segment used for MQTT/UNS routing; display/input state is normalized by the bridge."
                  },
                  "forecast_date": {
                    "type": "string",
                    "description": "Topic-safe forecast date normalized to YYYY-MM-DD. Used as the retained MQTT daily slot with message expiry."
                  },
                  "uv_index": {
