{
  "name": "Nextbus",
  "description": "Nextbus / UMOIQ public XML feed CloudEvents.",
  "endpoints": {
    "nextbus.Kafka": {
      "usage": [
        "producer"
      ],
      "protocol": "KAFKA",
      "envelope": "CloudEvents/1.0",
      "envelopeoptions": {
        "mode": "structured",
        "format": "application/cloudevents+json"
      },
      "protocoloptions": {
        "deployed": false,
        "options": {
          "topic": "nextbus"
        }
      },
      "messagegroups": [
        "#/messagegroups/nextbus.kafka",
        "#/messagegroups/nextbus.kafka.avro",
        "#/messagegroups/nextbus.kafka.avro.binary"
      ],
      "description": "Kafka endpoint for Nextbus events. Per-message partition keys are declared on the messages of the nextbus.kafka overlay group and mirror each message's CloudEvents subject."
    },
    "nextbus.Mqtt": {
      "usage": [
        "producer"
      ],
      "protocol": "MQTT/5.0",
      "envelope": "CloudEvents/1.0",
      "envelopeoptions": {
        "mode": "binary"
      },
      "protocoloptions": {
        "deployed": false,
        "endpoints": [
          {
            "uri": "mqtt://localhost:1883"
          }
        ]
      },
      "messagegroups": [
        "#/messagegroups/nextbus.mqtt",
        "#/messagegroups/nextbus.mqtt.avro",
        "#/messagegroups/nextbus.mqtt.avro.binary"
      ],
      "description": "MQTT/5.0 companion producer endpoint."
    },
    "nextbus.Amqp": {
      "usage": [
        "producer"
      ],
      "protocol": "AMQP/1.0",
      "envelope": "CloudEvents/1.0",
      "envelopeoptions": {
        "mode": "binary"
      },
      "protocoloptions": {
        "deployed": false,
        "options": {
          "content_mode": "binary",
          "address": "nextbus"
        }
      },
      "messagegroups": [
        "#/messagegroups/nextbus.amqp",
        "#/messagegroups/nextbus.amqp.avro",
        "#/messagegroups/nextbus.amqp.avro.binary"
      ],
      "description": "AMQP/1.0 companion producer endpoint."
    }
  },
  "messagegroups": {
    "nextbus": {
      "description": "Nextbus vehicle and route reference events.",
      "messages": {
        "nextbus.VehiclePosition": {
          "name": "VehiclePosition",
          "envelope": "CloudEvents/1.0",
          "envelopemetadata": {
            "type": {
              "value": "nextbus.VehiclePosition"
            },
            "source": {
              "value": "https://retro.umoiq.com/service/publicXMLFeed"
            },
            "subject": {
              "value": "{agency_id}/{route_tag}/vehicle/{vehicle_id}",
              "type": "uritemplate"
            },
            "time": {
              "value": "{timestamp}",
              "type": "timestamp"
            },
            "datacontenttype": {
              "type": "string",
              "value": "application/json"
            }
          },
          "dataschemaformat": "JsonStructure/draft-02",
          "dataschemauri": "#/schemagroups/nextbus.jstruct/schemas/nextbus.VehiclePosition",
          "description": "Nextbus VehiclePosition event."
        },
        "nextbus.RouteConfig": {
          "name": "RouteConfig",
          "envelope": "CloudEvents/1.0",
          "envelopemetadata": {
            "type": {
              "value": "nextbus.RouteConfig"
            },
            "source": {
              "value": "https://retro.umoiq.com/service/publicXMLFeed"
            },
            "subject": {
              "value": "{agency_id}/{route_tag}/route-config/{stop_or_vehicle_id}",
              "type": "uritemplate"
            },
            "time": {
              "value": "{timestamp}",
              "type": "timestamp"
            },
            "datacontenttype": {
              "type": "string",
              "value": "application/json"
            }
          },
          "dataschemaformat": "JsonStructure/draft-02",
          "dataschemauri": "#/schemagroups/nextbus.jstruct/schemas/nextbus.RouteConfig",
          "description": "Nextbus RouteConfig event."
        },
        "nextbus.Schedule": {
          "name": "Schedule",
          "envelope": "CloudEvents/1.0",
          "envelopemetadata": {
            "type": {
              "value": "nextbus.Schedule"
            },
            "source": {
              "value": "https://retro.umoiq.com/service/publicXMLFeed"
            },
            "subject": {
              "value": "{agency_id}/{route_tag}/schedule/{stop_or_vehicle_id}",
              "type": "uritemplate"
            },
            "time": {
              "value": "{timestamp}",
              "type": "timestamp"
            },
            "datacontenttype": {
              "type": "string",
              "value": "application/json"
            }
          },
          "dataschemaformat": "JsonStructure/draft-02",
          "dataschemauri": "#/schemagroups/nextbus.jstruct/schemas/nextbus.Schedule",
          "description": "Nextbus Schedule event."
        },
        "nextbus.Message": {
          "name": "Message",
          "envelope": "CloudEvents/1.0",
          "envelopemetadata": {
            "type": {
              "value": "nextbus.Message"
            },
            "source": {
              "value": "https://retro.umoiq.com/service/publicXMLFeed"
            },
            "subject": {
              "value": "{agency_id}/{route_tag}/message/{stop_or_vehicle_id}",
              "type": "uritemplate"
            },
            "time": {
              "value": "{timestamp}",
              "type": "timestamp"
            },
            "datacontenttype": {
              "type": "string",
              "value": "application/json"
            }
          },
          "dataschemaformat": "JsonStructure/draft-02",
          "dataschemauri": "#/schemagroups/nextbus.jstruct/schemas/nextbus.Message",
          "description": "Nextbus Message event."
        }
      }
    },
    "nextbus.mqtt": {
      "description": "MQTT 5 UNS topic bindings for nextbus.",
      "messages": {
        "nextbus.VehiclePosition.mqtt": {
          "name": "VehiclePosition",
          "basemessageuri": "/messagegroups/nextbus/messages/nextbus.VehiclePosition",
          "protocol": "MQTT/5.0",
          "protocoloptions": {
            "topic_name": "transit/intl/nextbus/nextbus/{agency_id}/{route_tag}/{event_type}/{stop_or_vehicle_id}",
            "qos": 1,
            "retain": false
          }
        },
        "nextbus.RouteConfig.mqtt": {
          "name": "RouteConfig",
          "basemessageuri": "/messagegroups/nextbus/messages/nextbus.RouteConfig",
          "protocol": "MQTT/5.0",
          "protocoloptions": {
            "topic_name": "transit/intl/nextbus/nextbus/{agency_id}/{route_tag}/{event_type}/{stop_or_vehicle_id}",
            "qos": 1,
            "retain": false
          }
        },
        "nextbus.Schedule.mqtt": {
          "name": "Schedule",
          "basemessageuri": "/messagegroups/nextbus/messages/nextbus.Schedule",
          "protocol": "MQTT/5.0",
          "protocoloptions": {
            "topic_name": "transit/intl/nextbus/nextbus/{agency_id}/{route_tag}/{event_type}/{stop_or_vehicle_id}",
            "qos": 1,
            "retain": false
          }
        },
        "nextbus.Message.mqtt": {
          "name": "Message",
          "basemessageuri": "/messagegroups/nextbus/messages/nextbus.Message",
          "protocol": "MQTT/5.0",
          "protocoloptions": {
            "topic_name": "transit/intl/nextbus/nextbus/{agency_id}/{route_tag}/{event_type}/{stop_or_vehicle_id}",
            "qos": 1,
            "retain": false
          }
        }
      }
    },
    "nextbus.amqp": {
      "description": "AMQP 1.0 bindings for nextbus.",
      "messages": {
        "nextbus.VehiclePosition.amqp": {
          "name": "VehiclePosition",
          "basemessageuri": "/messagegroups/nextbus/messages/nextbus.VehiclePosition",
          "protocol": "AMQP/1.0",
          "protocoloptions": {
            "properties": {
              "subject": {
                "type": "uritemplate",
                "value": "{agency_id}/{route_tag}/vehicle/{vehicle_id}",
                "description": "AMQP subject mirrors the CloudEvents subject."
              }
            },
            "message-annotations": {
              "x-opt-partition-key": {
                "type": "uritemplate",
                "value": "{agency_id}/{route_tag}/vehicle/{vehicle_id}",
                "description": "Partition key mirrors the CloudEvents subject."
              }
            }
          }
        },
        "nextbus.RouteConfig.amqp": {
          "name": "RouteConfig",
          "basemessageuri": "/messagegroups/nextbus/messages/nextbus.RouteConfig",
          "protocol": "AMQP/1.0",
          "protocoloptions": {
            "properties": {
              "subject": {
                "type": "uritemplate",
                "value": "{agency_id}/{route_tag}/route-config/{stop_or_vehicle_id}",
                "description": "AMQP subject mirrors the CloudEvents subject."
              }
            },
            "message-annotations": {
              "x-opt-partition-key": {
                "type": "uritemplate",
                "value": "{agency_id}/{route_tag}/route-config/{stop_or_vehicle_id}",
                "description": "Partition key mirrors the CloudEvents subject."
              }
            }
          }
        },
        "nextbus.Schedule.amqp": {
          "name": "Schedule",
          "basemessageuri": "/messagegroups/nextbus/messages/nextbus.Schedule",
          "protocol": "AMQP/1.0",
          "protocoloptions": {
            "properties": {
              "subject": {
                "type": "uritemplate",
                "value": "{agency_id}/{route_tag}/schedule/{stop_or_vehicle_id}",
                "description": "AMQP subject mirrors the CloudEvents subject."
              }
            },
            "message-annotations": {
              "x-opt-partition-key": {
                "type": "uritemplate",
                "value": "{agency_id}/{route_tag}/schedule/{stop_or_vehicle_id}",
                "description": "Partition key mirrors the CloudEvents subject."
              }
            }
          }
        },
        "nextbus.Message.amqp": {
          "name": "Message",
          "basemessageuri": "/messagegroups/nextbus/messages/nextbus.Message",
          "protocol": "AMQP/1.0",
          "protocoloptions": {
            "properties": {
              "subject": {
                "type": "uritemplate",
                "value": "{agency_id}/{route_tag}/message/{stop_or_vehicle_id}",
                "description": "AMQP subject mirrors the CloudEvents subject."
              }
            },
            "message-annotations": {
              "x-opt-partition-key": {
                "type": "uritemplate",
                "value": "{agency_id}/{route_tag}/message/{stop_or_vehicle_id}",
                "description": "Partition key mirrors the CloudEvents subject."
              }
            }
          }
        }
      }
    },
    "nextbus.kafka": {
      "description": "Kafka transport overlay for nextbus. Each message inherits envelope and envelopemetadata from the transport-neutral message in the nextbus group via basemessageuri and declares a per-message Kafka partition key that exactly matches its CloudEvents subject.",
      "messages": {
        "nextbus.kafka.VehiclePosition": {
          "name": "VehiclePosition",
          "basemessageuri": "/messagegroups/nextbus/messages/nextbus.VehiclePosition",
          "protocol": "KAFKA",
          "protocoloptions": {
            "key": "{agency_id}/{route_tag}/vehicle/{vehicle_id}"
          }
        },
        "nextbus.kafka.RouteConfig": {
          "name": "RouteConfig",
          "basemessageuri": "/messagegroups/nextbus/messages/nextbus.RouteConfig",
          "protocol": "KAFKA",
          "protocoloptions": {
            "key": "{agency_id}/{route_tag}/route-config/{stop_or_vehicle_id}"
          }
        },
        "nextbus.kafka.Schedule": {
          "name": "Schedule",
