          "protocol": "KAFKA",
          "protocoloptions": {
            "key": "{agency_id}/{route_tag}/schedule/{stop_or_vehicle_id}"
          }
        },
        "nextbus.kafka.Message": {
          "name": "Message",
          "basemessageuri": "/messagegroups/nextbus/messages/nextbus.Message",
          "protocol": "KAFKA",
          "protocoloptions": {
            "key": "{agency_id}/{route_tag}/message/{stop_or_vehicle_id}"
          }
        }
      }
